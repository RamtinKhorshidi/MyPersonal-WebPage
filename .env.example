# Contact form (optional). Copy this file to .env.local and fill in the values
# from your EmailJS dashboard (https://www.emailjs.com). .env.local is
# git-ignored. Without these, the form opens the visitor's email app instead.
# These are public identifiers that ship in the browser bundle, not secrets.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
